/*
 * ----------------------------------------------------------------------------
 *  Nextflow config file for use with Singularity on MUB's HPC
 * ----------------------------------------------------------------------------
 */

params {
  config_profile_description = 'MUB/CBiAD cluster profile provided by nf-core/configs.'
  config_profile_contact = 'Adrian Janucik (@ajandria)'
}

process {
  beforeScript = 'module load MOD/singularityce/3.11.1'
  executor = 'pbspro'
  queue = 'workq'
  singularity.cacheDir = '/archive/singularityCacheDir'
}

params {
  max_memory = 512.GB
  max_cpus = 42
  max_time = 240.h
}
